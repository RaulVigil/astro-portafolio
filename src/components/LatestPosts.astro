---
import { blogConfig } from "../data";
import { getPosts, isoDate, postUrl } from "../lib/blog";

const posts = (await getPosts()).slice(0, 3);
---

{posts.length > 0 && (
<section class="py-stack-lg border-t border-border-subtle/50 animate-on-scroll" id="blog">
<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
<div>
<h2 class="text-headline-md font-headline-md text-primary inline-flex items-center gap-2">
<span class="material-symbols-outlined">article</span> Últimos artículos
            </h2>
<p class="mt-2 text-body-md font-body-md text-text-secondary">En {blogConfig.name}, mi blog técnico, documento problemas reales de desarrollo y el código que los resuelve.</p>
</div>
<a href="/blog/" class="inline-flex shrink-0 items-center text-label-md font-label-md text-surface-tint hover:text-primary transition-colors">
              Ver todos los artículos <span class="material-symbols-outlined ml-1 text-[18px]">arrow_forward</span>
</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{posts.map((post) => (
<article class="glass-panel rounded-xl p-6 flex flex-col">
<time datetime={isoDate(post.data.pubDate)} class="text-label-sm font-label-sm text-text-secondary">{isoDate(post.data.pubDate)}</time>
<h3 class="mt-3 text-body-lg font-headline-md text-text-primary mb-2">
<a href={postUrl(post)} class="hover:text-primary transition-colors">{post.data.title}</a>
</h3>
<p class="text-body-md font-body-md text-text-secondary line-clamp-3">{post.data.description}</p>
<div class="mt-auto pt-5 flex flex-wrap gap-2">
{post.data.tags.slice(0, 3).map((tag) => (
<span class="text-label-sm font-label-sm text-primary px-2 py-1 bg-primary/10 rounded">{tag}</span>
))}
</div>
</article>
))}
</div>
</section>
)}
