---
import Logo from './Logo.astro';
import { blogConfig, siteConfig } from '../../data';

const year = new Date().getFullYear();
const links = [
  { href: '/blog/rss.xml', label: 'rss' },
  { href: siteConfig.socials.github, label: 'github' },
  { href: siteConfig.socials.linkedin, label: 'linkedin' },
  { href: '/privacidad/', label: 'privacidad' },
];
---

<footer class="mt-24 border-t border-pp-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 font-pp-mono text-xs text-pp-faint sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <div class="flex flex-col gap-3">
      <Logo href="/blog/" size="sm" cursor={false} />
      <p>
        escrito por <a href="/" class="text-pp-muted underline decoration-pp-border underline-offset-4 hover:text-pp-text">{blogConfig.author.name}</a> · © {year}
      </p>
    </div>
    <ul class="flex gap-5">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="transition-colors hover:text-pp-text"
            {...(href.startsWith('http') && { target: '_blank', rel: 'noopener' })}
          >{label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
