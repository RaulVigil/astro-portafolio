---
/**
 * Logotipo de Prompt & Patch: `> prompt & patch▌`.
 * Texto real (no SVG): se copia, se indexa y escala con la tipografía.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  /** Cursor de bloque parpadeante. Se detiene con prefers-reduced-motion. */
  cursor?: boolean;
  class?: string;
}

const { size = 'md', href, cursor = true, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class:list={['pp-logo', `pp-logo--${size}`, className]}>
  <span class="pp-logo-caret" aria-hidden="true">&gt;</span> prompt <span class="pp-logo-amp">&amp;</span> patch{cursor && <span class="pp-logo-cursor" aria-hidden="true" />}
</Tag>

<style>
  .pp-logo {
    display: inline-block;
    font-family: var(--font-pp-mono);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-pp-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .pp-logo--sm { font-size: 0.9375rem; }
  .pp-logo--md { font-size: 1.25rem; }
  .pp-logo--lg { font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: -0.045em; }

  .pp-logo-caret {
    color: var(--color-pp-amber);
    font-weight: 700;
  }

  .pp-logo-amp {
    color: var(--color-pp-faint);
    transition: color 150ms ease;
  }

  a.pp-logo:hover .pp-logo-amp,
  a.pp-logo:focus-visible .pp-logo-amp {
    color: var(--color-pp-amber);
  }

  .pp-logo-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.12em;
    vertical-align: -0.17em;
    background: var(--color-pp-amber);
    animation: pp-blink 1.1s steps(1, end) infinite;
  }

  @keyframes pp-blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-logo-cursor { animation: none; }
  }
</style>
