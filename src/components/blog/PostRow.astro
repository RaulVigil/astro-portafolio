---
import TagLink from './TagLink.astro';
import { isoDate, postUrl, readingTime, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  /** h2 en listados planos, h3 cuando cuelga de un encabezado (año, "sigue leyendo"). */
  as?: 'h2' | 'h3';
}

const { post, as: Heading = 'h2' } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="group grid gap-x-10 gap-y-2 py-7 sm:grid-cols-[6.5rem_minmax(0,1fr)]">
  <time datetime={isoDate(pubDate)} class="font-pp-mono text-[13px] text-pp-faint sm:pt-[0.3rem]">
    {isoDate(pubDate)}
  </time>
  <div>
    <Heading class="text-xl font-semibold leading-snug tracking-tight text-pp-text sm:text-[1.375rem]">
      <a href={postUrl(post)} class="relative outline-none focus-visible:text-pp-amber">
        <span
          aria-hidden="true"
          class="absolute -left-[1.4ch] font-pp-mono text-pp-amber opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
        >&gt;</span>
        {title}
      </a>
    </Heading>
    <p class="mt-2 max-w-[65ch] leading-relaxed text-pp-muted">{description}</p>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
      {draft && (
        <span class="border border-pp-amber/40 px-1.5 py-px font-pp-mono text-[11px] uppercase tracking-wider text-pp-amber">borrador</span>
      )}
      <span class="font-pp-mono text-xs text-pp-faint">{readingTime(post.body)} min</span>
      {tags.map((tag) => <TagLink tag={tag} />)}
    </div>
  </div>
</article>
