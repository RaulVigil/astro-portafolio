---
import "../styles/global.css";
import "../styles/blog.css";
import BlogHeader from "../components/blog/BlogHeader.astro";
import BlogFooter from "../components/blog/BlogFooter.astro";
import { blogConfig } from "../data";

interface Props {
  /** <title> final. Para artículos usar metaTitle() de src/lib/blog.ts. */
  title: string;
  description: string;
  /** Ruta en /public de la imagen Open Graph (1200×630). */
  image?: string;
  type?: "website" | "article";
  /** Fechas de publicación y modificación para og:article. */
  published?: Date;
  modified?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Bloques JSON-LD adicionales. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/images/og-image.png",
  type = "website",
  published,
  modified,
  tags = [],
  noindex = false,
  schema = [],
} = Astro.props;

// Todas las páginas del blog se sirven como directorio: la canónica termina en "/".
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
const imageURL = new URL(image, Astro.site);
const rssURL = new URL("/blog/rss.xml", Astro.site);
const { client: adsenseClient } = blogConfig.adsense;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={blogConfig.author.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#0a0a0c" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={blogConfig.name} href={rssURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={blogConfig.name} />
    <meta property="og:locale" content="es_SV" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === "article" && <meta property="article:author" content={blogConfig.author.url} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q3JZVR2VG3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Q3JZVR2VG3');
    </script>

    {adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Inter (lectura) + JetBrains Mono (marca, metadatos, código) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col bg-pp-bg font-pp-sans text-pp-text antialiased selection:bg-pp-amber selection:text-pp-bg">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-pp-amber focus:px-3 focus:py-2 focus:font-pp-mono focus:text-sm focus:text-pp-bg"
    >Saltar al contenido</a>
    <BlogHeader />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <BlogFooter />
  </body>
</html>
