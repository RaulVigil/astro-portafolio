---
import { render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostRow from '../../components/blog/PostRow.astro';
import TagLink from '../../components/blog/TagLink.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import AdSlot from '../../components/blog/AdSlot.astro';
import { blogConfig, siteConfig } from '../../data';
import {
  formatDate,
  getPosts,
  getRelatedPosts,
  isoDate,
  metaTitle,
  postUrl,
  readingTime,
  wordCount,
  type Post,
} from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: getRelatedPosts(post, posts) },
  }));
}

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ogImage, draft } = post.data;
const { Content, headings } = await render(post);

const url = new URL(postUrl(post), Astro.site).href;
const blogUrl = new URL('/blog/', Astro.site).href;
const image = ogImage ?? '/images/og-image.png';
const author = {
  '@type': 'Person',
  name: blogConfig.author.name,
  url: blogConfig.author.url,
  jobTitle: 'Ingeniero en Sistemas & Full Stack Developer',
  sameAs: [
    siteConfig.socials.linkedin,
    siteConfig.socials.github,
  ],
  knowsAbout: [
    'Astro',
    'React',
    'Next.js',
    'TypeScript',
    'Node.js',
    'PHP',
    'Tailwind CSS',
    'Vite',
    'APIs RESTful',
  ],
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['BlogPosting', 'TechArticle'],
    headline: title,
    description,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: new URL(image, Astro.site).href,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: 'es',
    keywords: tags.join(', '),
    dependencies: tags.join(', '),
    proficiencyLevel: 'Expert',
    wordCount: wordCount(post.body),
    author,
    publisher: author,
    isPartOf: { '@type': 'Blog', name: blogConfig.name, url: blogUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'raulo.dev', item: blogConfig.author.url },
      { '@type': 'ListItem', position: 2, name: blogConfig.name, item: blogUrl },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<BlogLayout
  title={metaTitle(title)}
  {description}
  {image}
  type="article"
  published={pubDate}
  modified={updatedDate ?? pubDate}
  {tags}
  noindex={draft}
  {schema}
>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <article>
      <header class="max-w-3xl pt-10 pb-10 sm:pt-14">
        <nav aria-label="Ruta" class="font-pp-mono text-[13px] text-pp-faint">
          <ol class="flex flex-wrap items-center gap-x-1.5">
            <li><a href="/" class="hover:text-pp-text">raulo.dev</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/" class="hover:text-pp-text">blog</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-pp-muted">{post.id}</li>
          </ol>
        </nav>

        <h1 class="mt-8 text-[2rem] font-bold leading-[1.12] tracking-[-0.03em] text-balance sm:text-[2.75rem]">
          {title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-pp-muted sm:text-xl">{description}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 font-pp-mono text-xs text-pp-faint">
          {draft && <span class="border border-pp-amber/40 px-1.5 py-px uppercase tracking-wider text-pp-amber">borrador</span>}
          <span>por <a href="/" class="text-pp-muted hover:text-pp-text">{blogConfig.author.name}</a></span>
          <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
          {updatedDate && <span>act. <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time></span>}
          <span>{readingTime(post.body)} min de lectura</span>
          <span class="flex flex-wrap gap-x-3">{tags.map((tag) => <TagLink tag={tag} />)}</span>
        </div>
      </header>

      <div class="border-t border-pp-border pt-10 lg:grid lg:grid-cols-[minmax(0,44rem)_13rem] lg:justify-between lg:gap-16">
        <div>
          <TableOfContents headings={headings} variant="inline" />
          <div class="pp-prose mt-8 lg:mt-0">
            <Content />
          </div>
        </div>
        <aside class="hidden lg:block">
          <div class="sticky top-8">
            <TableOfContents headings={headings} variant="sidebar" />
          </div>
        </aside>
      </div>
    </article>

    <div class="max-w-[44rem]">
      <AdSlot slot={blogConfig.adsense.slots.postEnd} label="final del artículo" class="mt-16" />

      <section aria-label="Sobre el autor" class="mt-16 rounded-md border border-pp-border bg-pp-surface p-6">
        <p class="font-pp-mono text-xs text-pp-faint">$ whoami</p>
        <p class="mt-3 leading-relaxed text-pp-prose">
          <a href="/" class="font-semibold text-pp-text hover:text-pp-amber">{blogConfig.author.name}</a> — {blogConfig.author.bio}
        </p>
        <ul class="mt-4 flex gap-5 font-pp-mono text-xs text-pp-muted">
          <li><a href="/" class="hover:text-pp-text">portafolio</a></li>
          <li><a href={siteConfig.socials.github} target="_blank" rel="noopener" class="hover:text-pp-text">github</a></li>
          <li><a href={siteConfig.socials.linkedin} target="_blank" rel="noopener" class="hover:text-pp-text">linkedin</a></li>
        </ul>
      </section>

      {related.length > 0 && (
        <section aria-labelledby="related-title" class="mt-20">
          <h2 id="related-title" class="font-pp-mono text-xs uppercase tracking-wider text-pp-faint">sigue leyendo</h2>
          <div class="mt-2 divide-y divide-pp-border">
            {related.map((p) => <PostRow post={p} as="h3" />)}
          </div>
        </section>
      )}

      <a href="/blog/" class="mt-14 inline-block font-pp-mono text-[13px] text-pp-muted hover:text-pp-text">
        <span class="text-pp-amber">cd</span> ../todos-los-articulos
      </a>
    </div>
  </div>
</BlogLayout>

<script>
  // Botón "copiar" en cada bloque de código. Posición absoluta: no desplaza contenido.
  for (const frame of document.querySelectorAll<HTMLElement>('.pp-prose .pp-code')) {
    const pre = frame.querySelector('pre');
    if (!pre || !navigator.clipboard) continue;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'pp-code-copy';
    button.textContent = 'copiar';
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.innerText);
      button.textContent = 'copiado';
      button.dataset.copied = '';
      setTimeout(() => {
        button.textContent = 'copiar';
        delete button.dataset.copied;
      }, 1600);
    });
    frame.append(button);
  }

  // Resalta en el índice lateral la sección que se está leyendo.
  const links = new Map<string, HTMLElement>();
  for (const link of document.querySelectorAll<HTMLElement>('[data-toc-link]')) {
    links.set(link.dataset.tocLink!, link);
  }
  if (links.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links.values()) link.removeAttribute('aria-current');
          links.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    for (const heading of document.querySelectorAll('.pp-prose h2[id], .pp-prose h3[id]')) {
      observer.observe(heading);
    }
  }
</script>
