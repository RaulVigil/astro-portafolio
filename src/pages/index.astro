---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.jsx';
import About from '../components/About.jsx';
import Skills from '../components/Skills.jsx';
import Projects from '../components/Projects.jsx';
import Experience from '../components/Experience.jsx';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, projects } from '../data';
import { responsiveImage } from '../lib/images';
import photo from '../assets/photo.png';
import jaxWebsite from '../assets/projects/jax-website.png';
import kanbanDev from '../assets/projects/kanban-dev.png';
import esOferta from '../assets/projects/es-oferta-de-verdad.png';

// WebP en dos anchos: la foto se ve a ~420px y las tarjetas de proyecto a ~576px (x2 para pantallas retina).
const photoImage = await responsiveImage(photo, [400, 800], '(min-width: 768px) 420px, 100vw');
const projectImages = {
  jax: await responsiveImage(jaxWebsite, [600, 1024], '(min-width: 768px) 576px, 100vw'),
  kanban: await responsiveImage(kanbanDev, [600, 1024], '(min-width: 768px) 576px, 100vw'),
  oferta: await responsiveImage(esOferta, [600, 1024], '(min-width: 768px) 576px, 100vw'),
};

const projectsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Proyectos Destacados",
  "numberOfItems": projects.length,
  "itemListElement": projects.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "CreativeWork",
      "name": p.title,
      "description": p.description,
      "url": p.link || p.github || "https://raulo.dev/#proyectos",
      "image": p.image,
      "about": { "@type": "Thing", "name": p.tech.join(", ") }
    }
  }))
};
---

<Layout title={siteConfig.title} description={siteConfig.description} keywords={siteConfig.keywords}>
  <Header />
  
  <main class="pt-[100px] pb-stack-lg max-w-container-max mx-auto px-gutter md:px-[24px]">
    <Hero client:load />
    <About photo={photoImage} />
    <Skills />
    <Projects images={projectImages} />
    <Experience />
    <Services />
    <Contact />
  </main>

  <Footer />

  <!-- Structured Data: ItemList de proyectos -->
  <script type="application/ld+json" set:html={JSON.stringify(projectsSchema)} />
</Layout>
